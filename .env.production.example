# Copy to .env.production ON THE SERVER and fill in:
#   cp .env.production.example .env.production && chmod 600 .env.production

# Written once; docker-compose.prod.yml derives DATABASE_URL from it.
# Use URL-safe characters only (e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=CHANGE_ME_long_random

# Generate: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME

# Browser-facing; no /rtc suffix (the client SDK appends it). Build-time:
# changing it requires --build, not a restart.
NEXT_PUBLIC_LIVEKIT_URL=wss://dianavoice.online
